{
  "name": "techstore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web-store",
    "web-admin"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:store": "npm run dev --workspace=web-store",
    "dev:admin": "npm run dev --workspace=web-admin",
    "dev:webhook": "WEBHOOK_SECRET=${WEBHOOK_SECRET:-test_secret} node webhook/server.mjs",
    "dev": "concurrently -k -n server,store,admin -c blue,green,yellow \"npm run dev:server\" \"npm run dev:store\" \"npm run dev:admin\"",
    "build:store": "npm run build --workspace=web-store",
    "build:admin": "npm run build --workspace=web-admin",
    "build": "npm run build:store && npm run build:admin",
    "start": "node server/server.js",
    "db:setup": "node server/scripts/setup-db.js",
    "migrate": "node --env-file-if-exists=.env server/scripts/migrate.js",
    "create-admin": "node --env-file-if-exists=.env server/scripts/create-admin.js",
    "test": "npm run test:core && npm run test:web",
    "test:core": "node --env-file=.env --test --test-reporter=spec ../core/test/*.test.js",
    "test:web": "node --env-file=.env --test --test-reporter=spec ./test/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "epayco-sdk-node": "^1.4.4",
    "mercadopago": "^3.3.0"
  }
}
