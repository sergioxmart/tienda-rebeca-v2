# Copiar a `.env` (gitignored) y completar.
# No commitear el `.env` real.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Postgres
PGHOST=localhost
PGPORT=5432
# Rol app: queda como owner de la DB. `npm run db:setup` lo crea si no existe.
PGUSER=techstore
PGPASSWORD=
PGDATABASE=techstore

# Opcional: si PGUSER todavía no existe y querés que `npm run db:setup` use
# un superuser para crearlo, definilo acá. Si no, se usa PGUSER.
# Útil en Mac con homebrew: tu user del SO suele ser el superuser por defecto.
# PG_SUPERUSER=tu_user_mac
# PG_SUPERPASSWORD=

# Auth (generar con: openssl rand -hex 32)
JWT_SECRET=
REFRESH_SECRET=
COOKIE_SECRET=

# Webhook
WEBHOOK_PORT=9001
WEBHOOK_SECRET=

# Uploads
MAX_UPLOAD_BYTES=20971520

# Log
LOG_LEVEL=info

# ePayco Smart Checkout — Testing. Nunca pongas estas llaves en el frontend.
EPAYCO_TEST=true
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
# Para validar la firma del webhook. Equivalentes legacy: P_CUST_ID_CLIENTE y P_KEY.
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=
EPAYCO_CHECKOUT_URL=https://checkout.epayco.co/checkout-v2.js
EPAYCO_RESPONSE_URL=http://localhost:5173/pago/respuesta
EPAYCO_CONFIRMATION_URL=http://localhost:3000/api/webhooks/epayco

# Mercado Pago Checkout Pro — usa credenciales de prueba durante desarrollo.
MERCADOPAGO_TEST=true
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SUCCESS_URL=http://localhost:5173/pago/respuesta
MERCADOPAGO_FAILURE_URL=http://localhost:5173/pago/respuesta
MERCADOPAGO_PENDING_URL=http://localhost:5173/pago/respuesta
MERCADOPAGO_NOTIFICATION_URL=http://localhost:3000/api/webhooks/mercadopago
